# Postgres — single URL for Drizzle + the app (SvelteKit exposes it as DATABASE_URL on the server).
# TLS: append ?sslmode=require (e.g. managed Postgres).
# If a dashboard only gives host/user/password, build:
#   postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# Special characters in USER/PASS must be URL-encoded.
DATABASE_URL="postgres://user:password@host:5432/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Staff bootstrap (idempotent seed — first admin only)
ADMIN_USER=""
ADMIN_PASS=""

# Optional: Strapi / migration tooling only (not used by Drizzle)
JWT_SECRET=
